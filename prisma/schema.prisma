generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }
enum Role { ADMIN TEACHER STUDENT }
enum LessonType { THEORY PRACTICE }
model User { id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role @default(STUDENT)
  createdAt DateTime @default(now())
  results TestResult[]
  submissions Submission[]
  assignments Assignment[] }
model Course { id String @id @default(cuid())
  title String
  description String?
  totalHours Int @default(60)
  modules Module[] }
model Module { id String @id @default(cuid())
  title String
  order Int
  courseId String
  course Course @relation(fields:[courseId],references:[id])
  lessons Lesson[] }
model Lesson { id String @id @default(cuid())
  order Int
  title String
  type LessonType
  hours Int @default(2)
  goal String
  outcomes String
  plan String
  concepts String
  content String @db.Text
  examples String @db.Text
  questions String @db.Text
  homework String @db.Text
  conclusion String @db.Text
  references String
  moduleId String
  module Module @relation(fields:[moduleId],references:[id])
  materials LessonMaterial[]
  presentation Presentation?
  videos Video[]
  tests Test[]
  assignments Assignment[] }
model LessonMaterial { id String @id @default(cuid())
  kind String
  url String
  title String
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id]) }
model Presentation { id String @id @default(cuid())
  pptxUrl String
  pdfUrl String
  lessonId String @unique
  lesson Lesson @relation(fields:[lessonId],references:[id]) }
model Video { id String @id @default(cuid())
  title String
  url String
  kind String @default("video")
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id]) }
model Test { id String @id @default(cuid())
  title String
  isFinal Boolean @default(false)
  lessonId String?
  lesson Lesson? @relation(fields:[lessonId],references:[id])
  questions Question[]
  results TestResult[] }
model Question { id String @id @default(cuid())
  text String
  multiple Boolean @default(false)
  testId String
  test Test @relation(fields:[testId],references:[id])
  answers Answer[] }
model Answer { id String @id @default(cuid())
  text String
  isCorrect Boolean @default(false)
  questionId String
  question Question @relation(fields:[questionId],references:[id]) }
model TestResult { id String @id @default(cuid())
  score Int
  percent Float
  createdAt DateTime @default(now())
  userId String
  testId String
  user User @relation(fields:[userId],references:[id])
  test Test @relation(fields:[testId],references:[id]) }
model Assignment { id String @id @default(cuid())
  title String
  description String
  deadline DateTime?
  lessonId String
  teacherId String
  lesson Lesson @relation(fields:[lessonId],references:[id])
  teacher User @relation(fields:[teacherId],references:[id])
  submissions Submission[] }
model Submission { id String @id @default(cuid())
  fileUrl String
  grade Int?
  comment String?
  createdAt DateTime @default(now())
  assignmentId String
  studentId String
  assignment Assignment @relation(fields:[assignmentId],references:[id])
  student User @relation(fields:[studentId],references:[id]) }
model Glossary { id String @id @default(cuid())
  en String
  uz String
  definition String
  usage String }
model LibraryFile { id String @id @default(cuid())
  title String
  category String
  url String
  createdAt DateTime @default(now()) }
